<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MhyunBox"
    x:Class="MhyunBox.MainWindow"
    UnknownProperty0x89A1="MhyUnbox">
    <Window.UnknownProperty0x8968>
        <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Children>
                <Grid x:Name="ContentBackgroundHost" RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.Children>
                        <Border x:Name="ContentBackgroundClipper"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="157,-2,-1,-3"
                            CornerRadius="0"
                            IsHitTestVisible="False">
                            <Border.Child>
                                <Grid x:Name="ContentBackgroundGrid">
                                    <Grid.Children>
                                        <Image x:Name="ContentBackground"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Stretch="UniformToFill"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False" />
                                    </Grid.Children>
                                </Grid>
                            </Border.Child>
                        </Border>
                    </Grid.Children>
                </Grid>
                <Border x:Name="PaneBackdrop"
                    RowSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Width="160"
                    Background="{ThemeResource SolidBackgroundFillColorBase}"
                    IsHitTestVisible="False" />
                <Grid x:Name="AppTitleBar" Row="0" Background="#00FFFFFF">
                    <Grid.Children>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <StackPanel.Children>
                                <Image x:Name="AppTitleIcon" Width="26" Height="26" Stretch="UniformToFill" Margin="12,0,0,0" />
                                <TextBlock x:Name="AppTitleTextBlock" Text="MhyUnbox" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel.Children>
                        </StackPanel>
                    </Grid.Children>
                </Grid>
                <Grid Row="1">
                    <Grid.Children>
                        <NavigationView x:Name="NavView"
                            PaneDisplayMode="Left"
                            IsPaneToggleButtonVisible="False"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="True"
                            AlwaysShowHeader="False"
                            OpenPaneLength="160" />
                        <Border x:Name="ToastHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            MaxWidth="600"
                            CornerRadius="8"
                            Background="#D91E1E1E"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="16,8"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <Border.Child>
                                <TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Border.Child>
                        </Border>
                    </Grid.Children>
                </Grid>
                <Border x:Name="ContentCard"
                    RowSpan="2"
                    Margin="157,0,0,0"
                    CornerRadius="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" />
                    </Border.RenderTransform>
                    <Border.Child>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Children>
                                <Frame x:Name="ContentFrame" Row="1" />
                                <Border x:Name="MiniPlayerHost"
                                    Row="2"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,6">
                                    <Border.Child>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Children>
                                                <StackPanel Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel.Children>
                                                        <TextBlock x:Name="MiniTrackText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                                <StackPanel
                                                    Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center"
                                                    Margin="16,0">
                                                    <StackPanel.Children>
                                                        <Slider x:Name="MiniVolumeSlider" Minimum="0" Maximum="100" Width="140" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="MiniVolumeText" FontSize="12" VerticalAlignment="Center" MinWidth="34" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                                <StackPanel Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel.Children>
                                                        <Button x:Name="MiniLibraryButton" Content="音乐列表" />
                                                        <Button x:Name="MiniReloadButton" Content="刷新" />
                                                        <Button x:Name="MiniPlayPauseButton" Content="播放" />
                                                        <Button x:Name="MiniPlayModeButton" Content="随机" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                            </Grid.Children>
                                        </Grid>
                                    </Border.Child>
                                </Border>
                            </Grid.Children>
                        </Grid>
                    </Border.Child>
                </Border>
            </Grid.Children>
        </Grid>
    </Window.UnknownProperty0x8968>
</Window>