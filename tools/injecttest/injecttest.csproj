<Project Sdk="Microsoft.NET.Sdk">
  <!-- 注入逻辑验证工具：直接引用主程序构件，对伪造的 PCL 客户端目录跑一遍 InjectAll，检查去重/更新结果 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>injecttest</AssemblyName>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MhyunBox">
      <HintPath>..\..\bin\Release\net8.0-windows10.0.19041.0\MhyunBox.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>..\..\lib\WinRT.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.WinUI">
      <HintPath>..\..\lib\Microsoft.WinUI.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>..\..\lib\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="BouncyCastle.Crypto">
      <HintPath>..\..\lib\BouncyCastle.Crypto.dll</HintPath>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>..\..\lib\System.Drawing.Common.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
