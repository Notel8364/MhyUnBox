<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="MhyunBox.Pages.LoginPage">
    <Page.Content>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Content>
                <StackPanel x:Name="LoginRoot" Padding="40,28" Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
                    <StackPanel.Children>
                        <TextBlock Text="账号绑定" FontSize="28" FontWeight="Bold" Margin="0,0,0,8" />
                        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
                        <InfoBar x:Name="ActivationGateBar" IsOpen="False" IsClosable="False">
                            <InfoBar.Content>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel.Children>
                                        <TextBlock x:Name="ActivationGateText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Name="GoActivateButton" Content="去激活" VerticalAlignment="Center" />
                                    </StackPanel.Children>
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>
                        <Grid x:Name="LoginCardGrid" Margin="0,8,0,0" ColumnSpacing="16" RowSpacing="12">
                            <Grid.Children>
                                <Border x:Name="StatusPanel"
                                    Row="0"
                                    Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12">
                                    <Border.Child>
                                        <StackPanel Spacing="6">
                                            <StackPanel.Children>
                                                <TextBlock x:Name="CurrentLoginText" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CurrentLoginExtra" Opacity="0.75" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                                    <StackPanel.Children>
                                                        <Button x:Name="AutoLoginButton" Content="自动登录（已保存会话）" />
                                                        <Button x:Name="RefreshRolesButton" Content="刷新角色" />
                                                        <Button x:Name="ClearButton" Content="清除本机记录" />
                                                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" VerticalAlignment="Center" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                                <Button x:Name="SessionsButton" Content="查看已保存账号会话" HorizontalAlignment="Left" />
                                                <Button x:Name="AssetBrowseButton" Content="资源包 / 皮肤浏览" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="RoleSummaryText" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                    </Border.Child>
                                </Border>
                                <Border x:Name="VerifyPanel"
                                    Row="1"
                                    Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12">
                                    <Border.Child>
                                        <StackPanel Spacing="8">
                                            <StackPanel.Children>
                                                <TextBlock Text="验证绑定" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <TextBlock Text="登录渠道" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <StackPanel.Children>
                                                        <ComboBox x:Name="ChannelSelect" MinWidth="220">
                                                            <ComboBox.Items>
                                                                <ComboBoxItem Content="网易邮箱" Tag="netease" />
                                                                <ComboBoxItem Content="网易手机号" Tag="netease-mobile" />
                                                                <ComboBoxItem Content="4399 账号" Tag="4399" />
                                                                <ComboBoxItem Content="4399 手机号" Tag="4399-mobile" />
                                                                <ComboBoxItem Content="Cookie 加载账号" Tag="cookie" />
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                        <Button x:Name="RegisterButton" Content="注册账号" VerticalAlignment="Center" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                                <TextBlock x:Name="AccountLabel" Text="邮箱账号" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Children>
                                                        <TextBox x:Name="AccountBox" Column="0" />
                                                        <ComboBox x:Name="EmailDomainSelect"
                                                            Column="1"
                                                            MinWidth="132"
                                                            VerticalAlignment="Center"
                                                            SelectedIndex="0"
                                                            Visibility="Collapsed">
                                                            <ComboBox.Items>
                                                                <ComboBoxItem Content="@163.com" Tag="163.com" />
                                                                <ComboBoxItem Content="@126.com" Tag="126.com" />
                                                                <ComboBoxItem Content="@yeah.net" Tag="yeah.net" />
                                                                <ComboBoxItem Content="@vip.163.com" Tag="vip.163.com" />
                                                                <ComboBoxItem Content="@188.com" Tag="188.com" />
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                    </Grid.Children>
                                                </Grid>
                                                <TextBlock x:Name="PasswordLabel" Text="登录密码" />
                                                <Grid x:Name="PasswordRow" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Children>
                                                        <PasswordBox x:Name="PasswordBox" Column="0" />
                                                        <Button x:Name="SendCodeButton" Column="1" Content="发送验证码" Visibility="Collapsed" MinWidth="112" />
                                                    </Grid.Children>
                                                </Grid>
                                                <Border x:Name="CookieConvertPanel"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    Visibility="Collapsed">
                                                    <Border.Child>
                                                        <StackPanel Spacing="6">
                                                            <StackPanel.Children>
                                                                <TextBlock Text="网易账密转 Cookie" FontWeight="SemiBold" />
                                                                <TextBlock Text="输入网易邮箱与密码生成 x19 Cookie 填入上方再「验证并绑定」（替代桌面版「网易163账号转Cookies」工具）。生成的 Cookie 会保存到本机，密码不保存。" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.Children>
                                                                        <TextBox x:Name="CookieEmailBox" Column="0" PlaceholderText="网易邮箱账号" />
                                                                        <ComboBox x:Name="CookieEmailDomainSelect" Column="1" MinWidth="132" VerticalAlignment="Center" SelectedIndex="0">
                                                                            <ComboBox.Items>
                                                                                <ComboBoxItem Content="@163.com" Tag="163.com" />
                                                                                <ComboBoxItem Content="@126.com" Tag="126.com" />
                                                                                <ComboBoxItem Content="@yeah.net" Tag="yeah.net" />
                                                                                <ComboBoxItem Content="@vip.163.com" Tag="vip.163.com" />
                                                                                <ComboBoxItem Content="@188.com" Tag="188.com" />
                                                                            </ComboBox.Items>
                                                                        </ComboBox>
                                                                    </Grid.Children>
                                                                </Grid>
                                                                <PasswordBox x:Name="CookiePasswordBox" PlaceholderText="登录密码（仅本次转换使用，不保存）" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <StackPanel.Children>
                                                                        <Button x:Name="CookieConvertButton" Content="账密转Cookie" />
                                                                        <Button x:Name="CopyCookieButton" Content="一键复制 Cookie" Visibility="Collapsed" />
                                                                        <TextBlock x:Name="CookieConvertHint" VerticalAlignment="Center" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                                    </StackPanel.Children>
                                                                </StackPanel>
                                                            </StackPanel.Children>
                                                        </StackPanel>
                                                    </Border.Child>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <StackPanel.Children>
                                                        <Button x:Name="VerifyButton" Content="验证并绑定" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                                        <TextBlock
                                                            Text="创建了对应角色后记得刷新角色"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Opacity="0.7"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                            </StackPanel.Children>
                                        </StackPanel>
                                    </Border.Child>
                                </Border>
                            </Grid.Children>
                        </Grid>
                    </StackPanel.Children>
                </StackPanel>
            </ScrollViewer.Content>
        </ScrollViewer>
    </Page.Content>
</Page>