<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="MhyunBox.Pages.SettingsPage">
    <Page.Resources>
        <Style x:Key="LibraryItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ControlTemplate.Template>
                            <Grid Background="#00FFFFFF">
                                <Grid.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.States>
                                            <VisualState x:Name="Normal">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="0.4" Duration="0:0:0.16" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                        </VisualStateGroup.States>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualStateGroup.States>
                                            <VisualState x:Name="Unselected">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="SelectedUnfocused">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="SelectedPointerOver">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Storyboard>
                                                    <Storyboard>
                                                        <Storyboard.Children>
                                                            <DoubleAnimation TargetName="SelectionVisual" TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                        </Storyboard.Children>
                                                    </Storyboard>
                                                </VisualState.Storyboard>
                                            </VisualState>
                                        </VisualStateGroup.States>
                                    </VisualStateGroup>
                                </Grid.VisualStateGroups>
                                <Grid.Children>
                                    <Border x:Name="SelectionVisual" Background="#33FFFFFF" CornerRadius="0" IsHitTestVisible="False" Opacity="0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid.Children>
                            </Grid>
                        </ControlTemplate.Template>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Page.Content>
        <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Content>
                <StackPanel x:Name="SettingsRoot" Padding="40,28" Spacing="6" HorizontalAlignment="Left">
                    <StackPanel.Children>
                        <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Margin="0,0,0,12" />
                        <Grid x:Name="SettingsGrid" MaxWidth="900" HorizontalAlignment="Left" ColumnSpacing="24" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.Children>
                                <StackPanel x:Name="ThemeGroup" Row="0" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock Text="主题模式" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        <ComboBox x:Name="ThemeCombo" MinWidth="220">
                                            <ComboBox.Items>
                                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                                <ComboBoxItem Content="深色" Tag="dark" />
                                                <ComboBoxItem Content="浅色" Tag="light" />
                                            </ComboBox.Items>
                                        </ComboBox>
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="BackgroundGroup" Row="1" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock Text="背景图片" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        <ComboBox x:Name="BackgroundCombo" MinWidth="300" />
                                        <TextBlock
                                            Text="图片/视频放在启动器目录 Assets\Backgrounds 下即可自动出现在这里（支持 jpg/png/webp/mp4 等）"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600" />
                                        <TextBlock
                                            Text="提示：mp4 背景建议使用 1080P 以下、小于 100MB 的视频，4K 或超大视频会占用大量内存"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                            <StackPanel.Children>
                                                <TextBox x:Name="CustomPathBox" Width="330" PlaceholderText="自定义背景绝对路径，例如 G:\E_VS_project\xiong.jpg" />
                                                <Button x:Name="BrowseButton" Content="浏览…" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                        <TextBlock x:Name="BackgroundPathHint"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600"
                                            IsTextSelectionEnabled="True" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="AppearanceGroup" Row="2" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock Text="背景淡化（透明度）" Margin="0,16,0,0" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <StackPanel.Children>
                                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Width="220" VerticalAlignment="Center" />
                                                <TextBlock x:Name="OpacityValueText" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                        <TextBlock Text="界面字体" FontWeight="SemiBold" Margin="0,16,0,0" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <StackPanel.Children>
                                                <Slider x:Name="FontSizeSlider" Width="220" VerticalAlignment="Center" />
                                                <TextBlock x:Name="FontSizeValueText" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FontBoldSwitch" Header="字体加粗" OnContent="已加粗" OffContent="正常" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="WindowGroup" Row="3" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock Text="窗口行为" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        <ToggleSwitch x:Name="ShowTrayIconSwitch" Header="托盘小图标" OnContent="保留（右下角图标）" OffContent="不显示托盘图标" />
                                        <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="最小化时隐藏到托盘" OnContent="隐藏到托盘" OffContent="最小化到任务栏" />
                                        <ToggleSwitch x:Name="CloseKeepsRunningSwitch" Header="关闭窗口时" OnContent="保留进程（托盘）" OffContent="退出程序" />
                                        <ToggleSwitch x:Name="AutoStartHiddenWindowSwitch" Header="开机自启时隐藏窗口" OnContent="静默启动到托盘" OffContent="正常显示窗口" />
                                        <TextBlock
                                            Text="开启后，开机自启时程序会静默启动到托盘（不弹窗口），需要配合「开机时自动启动」使用。"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600"
                                            Margin="0,2,0,4" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="StartupGroup" Row="4" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock Text="启动行为" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        <ToggleSwitch x:Name="AutoPlaySwitch" Header="启动时自动播放音乐" OnContent="自动播放" OffContent="不自动播放" />
                                        <ToggleSwitch x:Name="AutoStartSwitch" Header="开机时自动启动" OnContent="开机自启" OffContent="不自动启动" />
                                        <ToggleSwitch x:Name="AutoStartProxySwitch" Header="启动程序后自动启动代理" OnContent="自动启动代理" OffContent="不自动启动代理" />
                                        <ToggleSwitch x:Name="DetectGameSwitch" Header="开机检测游戏进程" OnContent="检测（发烧游戏平台/网易我的世界）" OffContent="不检测" />
                                        <TextBlock
                                            Text="检测到发烧游戏平台或网易我的世界正在运行时，弹窗询问是否结束相关进程（每次开机仅提醒一次）。"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600"
                                            Margin="0,2,0,4" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="SkinGroup" Row="5" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock Text="皮肤服务" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        <TextBlock
                                            Text="已内置开启，无需设置：进服后自动把所有玩家的皮肤替换为本地皮肤（改写 1.12.2 PlayerListItem）。"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600"
                                            Margin="0,2,0,4" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <StackPanel.Children>
                                                <TextBox x:Name="SkinDirBox" Width="360" IsReadOnly="True" PlaceholderText="皮肤文件目录，如 E:\MCLDownload\cache\skin" />
                                                <Button x:Name="SkinDirBrowseButton" Content="浏览…" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                        <TextBlock x:Name="SkinDirHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600" />
                                        <TextBlock x:Name="CslHint"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600"
                                            Margin="0,4,0,0" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="MusicGroup" Row="6" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock x:Name="MusicSectionLabel" Text="背景音乐" Margin="0,20,0,0" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <StackPanel.Children>
                                                <TextBox x:Name="MusicFolderBox" Width="280" IsReadOnly="True" PlaceholderText="未选择音乐文件夹" />
                                                <Button x:Name="MusicBrowseButton" Content="浏览…" />
                                                <Button x:Name="ReloadMusicButton" Content="重加载目录音乐" />
                                                <ComboBox x:Name="PlaybackModeCombo" MinWidth="88">
                                                    <ComboBox.Items>
                                                        <ComboBoxItem Content="随机" Tag="random" />
                                                        <ComboBoxItem Content="单曲循环" Tag="loop" />
                                                        <ComboBoxItem Content="列表循环" Tag="sequential" />
                                                    </ComboBox.Items>
                                                </ComboBox>
                                            </StackPanel.Children>
                                        </StackPanel>
                                        <TextBlock x:Name="MusicFolderHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <StackPanel x:Name="Mp4Group" Row="7" Column="0" Spacing="6">
                                    <StackPanel.Children>
                                        <TextBlock x:Name="Mp4SectionLabel" Text="MP4 音乐" Margin="0,16,0,0" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <StackPanel.Children>
                                                <TextBox x:Name="Mp4FolderBox" Width="280" IsReadOnly="True" PlaceholderText="未选择 MP4 文件夹" />
                                                <Button x:Name="Mp4BrowseButton" Content="浏览…" />
                                            </StackPanel.Children>
                                        </StackPanel>
                                        <TextBlock
                                            Text="选择音乐文件夹即可自动检测里面的音乐，并按所选模式自动播放；浏览 MP4 文件夹，其中的视频会自动并入上方音乐列表，点击播放时视频会在全窗背景中播放；右键歌曲可标记跳过（红色），已跳过的歌自动切歌时不会再播放"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            MaxWidth="600" />
                                        <TextBlock x:Name="Mp4FolderHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel.Children>
                                </StackPanel>
                                <Grid x:Name="MediaPanel" Row="8" Column="0" Margin="0,10,0,0">
                                    <Grid.Children>
                                        <ListView x:Name="MusicListBox"
                                            Height="132"
                                            MinWidth="0"
                                            FontSize="13"
                                            Background="#00FFFFFF"
                                            ItemContainerStyle="{StaticResource LibraryItemStyle}"
                                            IsItemClickEnabled="True" />
                                    </Grid.Children>
                                </Grid>
                            </Grid.Children>
                        </Grid>
                    </StackPanel.Children>
                </StackPanel>
            </ScrollViewer.Content>
        </ScrollViewer>
    </Page.Content>
</Page>